+// ------------------------------------------- first saloon, owned canary
+
+/**
+ * Footprint the ?car-body=canary visual MUST keep: the first-saloon slot's
+ * collider slabs derive from exactly these three numbers (the makeSaloon
+ * return for L 4.8 / W 1.95 / H 1.48: len L+0.24, wid W+0.09). Separate
+ * selector and separate dims from ?coach=canary; neither lane touches the
+ * other. Pattern re-scoped from adoptCoachCanary (tolerance downscale,
+ * procedural colliders, batching via the caller's park() path).
+ */
+const CAR_BODY_CANARY_DIMS = { len: 5.04, wid: 2.04, hgt: 1.48 } as const;
+
+// Uniform downscale only when a GLB axis overshoots the envelope by more than
+// this. Never upscales, never distorts per-axis.
+const CAR_BODY_GLB_TOLERANCE = 1.1;
+
+/**
+ * The opt-in first-saloon visual (?car-body=canary): the baked agy-0923 sedan GLB
+ * as an exclusively-owned root from build/car-body-canary. Null until the boot
+ * preload resolved 'ready'; every miss returns null and the caller falls back
+ * to the procedural saloon, so the map is complete either way and the
+ * procedural saloon is never built twice.
+ */
+function makeCarBodyOwned(): Vehicle | null {
+  const visual = carBodyCanaryVisual();
+  if (!visual) return null;
+  const bounds = new THREE.Box3().setFromObject(visual);
+  const size = bounds.getSize(new THREE.Vector3());
+  if (size.x <= 0 || size.y <= 0 || size.z <= 0) return null;
+  const over = Math.max(
+    size.x / CAR_BODY_CANARY_DIMS.len,
+    size.y / CAR_BODY_CANARY_DIMS.hgt,
+    size.z / CAR_BODY_CANARY_DIMS.wid,
+  );
+  if (over > CAR_BODY_GLB_TOLERANCE) {
+    visual.scale.multiplyScalar(1 / over);
+    visual.updateMatrixWorld(true);
+    visual.position.y -= new THREE.Box3().setFromObject(visual).min.y;
+  }
+  visual.name = 'saloon';
+  visual.userData.carBodySource = 'canary';
+  return {
+    obj: visual,
+    len: CAR_BODY_CANARY_DIMS.len,
+    wid: CAR_BODY_CANARY_DIMS.wid,
+    hgt: CAR_BODY_CANARY_DIMS.hgt,
+  };
+}
